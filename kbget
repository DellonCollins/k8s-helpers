#!/usr/bin/env bash

RESOURCE=${1-all}
MATCH='.*' 
KUBECTL_COMMAND="kubectl get $RESOURCE"
PRINT_MATCH="TRUE"

shift
while getopts "m: b" opt; do
	case $opt in
		m) MATCH="${OPTARG}" ;;
		b) PRINT_MATCH=;; 
		\?) echo "Invalid option: -$OPTARG" ;;
  	esac
done


if [[ -n $PRINT_MATCH ]] ; then
echo RESOURCE: $RESOURCE MATCH: $MATCH
echo
fi

while read -r line; do
	name=${line%% *}

	if [[ -z $line || $name == NAME ]] ; then
		continue
	fi

	if [[ $name =~ $MATCH ]] ; then
		echo $name
	fi
done < <($KUBECTL_COMMAND)
